# Copy to .env.local. Never commit .env.local.
APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Get LOCAL values from npm run db:status after starting Docker and db:start.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Reserved for later phases; no privileged client is implemented in P0.
SUPABASE_SECRET_KEY=
APP_INTERNAL_JOB_SECRET=
RATE_LIMIT_HASH_SECRET=
SHARE_TOKEN_ENCRYPTION_KEY=
AUTH_GOOGLE_ENABLED=false
AUTH_KAKAO_ENABLED=false
AUTH_REGISTRATION_ENABLED=false
FEATURE_ADULT_CATALOGUE=false
DEMO_MODE=false
