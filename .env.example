# Copy to .env.local. Never commit .env.local.
APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase project settings: use a publishable key OR legacy anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: use a secret key OR legacy service_role key. Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_INTERNAL_JOB_SECRET=
RATE_LIMIT_HASH_SECRET=
# Server-only: canonical base64 for 32 random bytes. Missing key disables
# unlisted publication/link recovery; never use a NEXT_PUBLIC_ variable.
SHARE_TOKEN_ENCRYPTION_KEY=
AUTH_GOOGLE_ENABLED=false
AUTH_KAKAO_ENABLED=false
AUTH_REGISTRATION_ENABLED=false
FEATURE_ADULT_CATALOGUE=false
DEMO_MODE=false
